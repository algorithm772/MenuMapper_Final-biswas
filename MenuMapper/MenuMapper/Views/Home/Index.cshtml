@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allergen Menu Mapper</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script crossorigin src="https://unpkg.com/react@@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>
    <script src="https://unpkg.com/lucide@@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: { 50: '#f0fdf4', 100: '#dcfce7', 500: '#22c55e', 600: '#16a34a', 900: '#14532d' },
                        danger: { 50: '#fef2f2', 100: '#fee2e2', 500: '#ef4444', 600: '#dc2626' },
                        warning: { 50: '#fffbeb', 100: '#fef3c7', 500: '#f59e0b', 600: '#d97706' }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f8fafc;
        }

        .mobile-container {
            max-width: 480px;
            margin: 0 auto;
            background: white;
            min-height: 100vh;
            box-shadow: 0 0 20px rgba(0,0,0,0.05);
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }

        /* Unified Animations */
        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        /* Continuous Subtle Floats for Homepage Spices */
        @@keyframes floatSlow {
            0%, 100% {
                transform: translateY(0px) rotate(0deg);
            }

            50% {
                transform: translateY(-12px) rotate(3deg);
            }
        }

        @@keyframes floatMedium {
            0%, 100% {
                transform: translateY(0px) rotate(0deg);
            }

            50% {
                transform: translateY(-18px) rotate(-4deg);
            }
        }

        @@keyframes pulseGlow {
            0%, 100% {
                opacity: 0.3;
                transform: scale(1) translate(-50%, -50%);
            }

            50% {
                opacity: 0.5;
                transform: scale(1.05) translate(-48%, -48%);
            }
        }

        .animate-slide-up {
            animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
        }

        .animate-slide-in {
            animation: slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .animate-fade-in {
            animation: fadeIn 0.4s ease-out forwards;
        }

        .animate-float-slow {
            animation: floatSlow 8s ease-in-out infinite;
        }

        .animate-float-medium {
            animation: floatMedium 10s ease-in-out infinite;
        }

        .animate-pulse-glow {
            animation: pulseGlow 12s ease-in-out infinite;
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo } = React;

        const IconCheck = () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"></path></svg>;
        const IconX = () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12"></path></svg>;
        const IconAlert = () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>;
        const IconLeaf = () => <svg className="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 11a9 9 0 019 9M4 11a9 9 0 019-9m-9 9a9 9 0 009-9m0 18a9 9 0 009-9m-9 9v-9"></path></svg>;

        const ALLERGEN_LIST = ["Dairy", "Nuts", "Gluten", "Egg", "Soy", "Fish", "Shellfish", "Sesame"];

        const INGREDIENT_TO_ALLERGEN_MAP = {
            'milk': 'Dairy', 'butter': 'Dairy', 'cheese': 'Dairy', 'paneer': 'Dairy', 'curd': 'Dairy', 'cream': 'Dairy', 'yogurt': 'Dairy',
            'peanut': 'Nuts', 'almond': 'Nuts', 'cashew': 'Nuts', 'coconut': 'Nuts', 'walnut': 'Nuts', 'pecan': 'Nuts', 'pistachio': 'Nuts',
            'wheat': 'Gluten', 'flour': 'Gluten', 'bread': 'Gluten', 'yeast': 'Gluten', 'barley': 'Gluten', 'rye': 'Gluten',
            'egg': 'Egg', 'mayo': 'Egg', 'mayonnaise': 'Egg',
            'soy': 'Soy', 'soya': 'Soy', 'soy sauce': 'Soy', 'tofu': 'Soy', 'edamame': 'Soy', 'tempeh': 'Soy', 'miso': 'Soy', 'tamari': 'Soy', 'soybean': 'Soy',
            'fish': 'Fish', 'salmon': 'Fish', 'tuna': 'Fish', 'cod': 'Fish', 'tilapia': 'Fish', 'anchovy': 'Fish', 'sardine': 'Fish', 'trout': 'Fish', 'mahi mahi': 'Fish', 'halibut': 'Fish',
            'shellfish': 'Shellfish', 'shrimp': 'Shellfish', 'crab': 'Shellfish', 'lobster': 'Shellfish', 'prawn': 'Shellfish', 'oyster': 'Shellfish', 'clam': 'Shellfish', 'scallop': 'Shellfish', 'mussel': 'Shellfish',
            'sesame': 'Sesame', 'tahini': 'Sesame'
        };

        function App() {
            const [view, setView] = useState('landing');
            const [menuItems, setMenuItems] = useState([]);

            const fetchMenu = () => {
                fetch('/api/menu').then(res => res.json()).then(data => setMenuItems(data));
            };

            useEffect(() => { fetchMenu(); }, []);

            return (
                <div className="min-h-screen flex flex-col">
                    <nav className="bg-white border-b border-gray-200 px-6 py-3 flex justify-between items-center z-50 sticky top-0 shadow-sm relative">
                        <div className="flex items-center gap-2 cursor-pointer relative z-10" onClick={() => setView('landing')}>
                            <IconLeaf />
                            <span className="font-bold text-xl text-slate-800 tracking-tight">ALLERGEN <span className="text-brand-600">MAPPER</span></span>
                        </div>
                        {/* Customer Menu button has been removed from here */}
                    </nav>

                    <div className="flex-1 flex flex-col relative w-full">
                        {view === 'landing' && <LandingPage setView={setView} />}
                        {view === 'dashboard' && <RestaurantDashboard menuItems={menuItems} fetchMenu={fetchMenu} />}
                        {view === 'customer' && <CustomerApp menuItems={menuItems} />}
                    </div>
                </div>
            );
        }

        /* --- PREMIUM ANIMATED SPICE MARKET HOMEPAGE WITH ADMIN LOGIN --- */
        function LandingPage({ setView }) {
            const [showLogin, setShowLogin] = useState(false);
            const [username, setUsername] = useState('');
            const [password, setPassword] = useState('');
            const [error, setError] = useState('');

            const handleLogin = (e) => {
                e.preventDefault();
                if (username === 'admin' && password === 'admin') {
                    setView('dashboard');
                } else {
                    setError('Invalid username or password');
                }
            };

            return (
                <div className="flex-1 bg-[#FAF8F5] flex flex-col items-center justify-center py-20 px-6 text-center relative overflow-hidden">

                    {/* Glowing Saffron & Turmeric Radial Backgrounds */}
                    <div className="absolute top-1/3 left-1/2 w-[700px] h-[700px] bg-orange-400/20 rounded-full blur-[120px] pointer-events-none z-0 transform -translate-x-1/2 -translate-y-1/2 animate-pulse-glow"></div>
                    <div className="absolute bottom-1/4 right-[10%] w-[500px] h-[500px] bg-yellow-400/20 rounded-full blur-[100px] pointer-events-none z-0 animate-pulse-glow" style={{animationDelay: '3s'}}></div>

                    {/* --- ARTWORK LAYER (8-10% Opacity) --- */}
                    {/* LEFT: Brass Bowl Spilling Turmeric/Chilli Powder */}
                    <div className="absolute top-[20%] left-[-2%] md:left-[2%] opacity-[0.10] text-[#9A3412] pointer-events-none z-0 animate-float-slow">
                        <svg width="300" height="300" viewBox="0 0 200 200" fill="currentColor">
                            <path d="M110 90 Q 130 110, 160 130 T 190 180 Q 150 170, 110 140 T 70 120 Z" opacity="0.5"/>
                            <circle cx="140" cy="120" r="5" opacity="0.8" />
                            <circle cx="160" cy="140" r="3" opacity="0.6" />
                            <circle cx="130" cy="150" r="6" opacity="0.9" />
                            <circle cx="170" cy="165" r="4" opacity="0.7" />
                            <circle cx="185" cy="155" r="2" opacity="0.5" />
                            <circle cx="115" cy="130" r="4" />
                            <path d="M30 60 Q 80 40, 110 90 Q 90 130, 40 110 Z" strokeWidth="6" stroke="currentColor" fill="none"/>
                            <path d="M45 75 Q 80 60, 95 95" strokeWidth="2" stroke="currentColor" fill="none"/>
                        </svg>
                    </div>

                    {/* RIGHT: Whole Spices Curving Toward Hero */}
                    <div className="absolute top-[10%] right-[-5%] md:right-[2%] opacity-[0.08] text-[#78350F] pointer-events-none z-0 animate-float-medium">
                        <svg width="350" height="450" viewBox="0 0 300 400" fill="currentColor">
                            <g transform="translate(50, 50) rotate(25) scale(1.8)">
                                <path d="M10 0 L13 7 L20 10 L13 13 L10 20 L7 13 L0 10 L7 7 Z" />
                                <circle cx="10" cy="10" r="2" fill="#FAF8F5" />
                            </g>
                            <g transform="translate(140, 180) rotate(-20) scale(1.5)">
                                <rect x="0" y="0" width="18" height="70" rx="5" fill="none" stroke="currentColor" strokeWidth="4" />
                                <path d="M6 0 V70 M12 0 V70" stroke="currentColor" strokeWidth="1.5" />
                            </g>
                            <ellipse cx="80" cy="280" rx="10" ry="18" transform="rotate(45 80 280)" />
                            <ellipse cx="110" cy="250" rx="8" ry="14" transform="rotate(75 110 250)" />
                            <circle cx="60" cy="220" r="6" />
                            <circle cx="40" cy="300" r="5" />
                            <circle cx="120" cy="320" r="7" />
                            <circle cx="140" cy="290" r="4" />
                            <g transform="translate(160, 360) rotate(45) scale(1.4)">
                                <path d="M10 0 L13 7 L20 10 L13 13 L10 20 L7 13 L0 10 L7 7 Z" />
                            </g>
                        </svg>
                    </div>

                    {/* BOTTOM LEFT: Rangoli & Terracotta Curves */}
                    <div className="absolute bottom-[-10%] left-[-5%] opacity-[0.06] text-[#9A3412] pointer-events-none z-0">
                        <svg width="300" height="300" viewBox="0 0 200 200" fill="none" stroke="currentColor" strokeWidth="2">
                            <path d="M0 200 A 100 100 0 0 1 100 100 L 0 100 Z" fill="currentColor" opacity="0.3" stroke="none" />
                            <path d="M0 100 Q 50 50, 100 0 Q 120 80, 200 100" />
                            <path d="M0 50 Q 50 25, 100 0" />
                            <path d="M50 100 Q 75 50, 150 0" />
                            <circle cx="0" cy="200" r="150" strokeDasharray="10 10" />
                            <circle cx="0" cy="200" r="180" strokeDasharray="5 15" strokeWidth="4"/>
                        </svg>
                    </div>

                    {/* BOTTOM RIGHT: Rangoli Mandela Edge */}
                    <div className="absolute bottom-[-8%] right-[-5%] opacity-[0.05] text-[#78350F] pointer-events-none z-0 transform scale-x-[-1]">
                        <svg width="250" height="250" viewBox="0 0 200 200" fill="none" stroke="currentColor" strokeWidth="2.5">
                            <path d="M0 100 Q 50 50, 100 0 Q 120 80, 200 100" />
                            <path d="M50 100 Q 75 50, 150 0" />
                            <circle cx="0" cy="200" r="130" strokeDasharray="15 15" />
                        </svg>
                    </div>

                    {/* Faint Peppercorn Scatters */}
                    <div className="absolute top-[25%] left-[25%] w-2 h-2 rounded-full bg-[#0F172A] opacity-10 blur-[0.5px] pointer-events-none z-0"></div>
                    <div className="absolute top-[28%] left-[23%] w-1.5 h-1.5 rounded-full bg-[#0F172A] opacity-[0.08] pointer-events-none z-0"></div>
                    <div className="absolute bottom-[35%] right-[20%] w-3 h-3 rounded-full bg-[#16A34A] opacity-10 blur-[1px] pointer-events-none z-0"></div>
                    <div className="absolute top-[65%] left-[15%] w-2 h-2 rounded-full bg-[#0F172A] opacity-[0.06] pointer-events-none z-0"></div>


                    {/* --- MAIN CENTERED CONTENT --- */}
                    <div className="max-w-3xl relative z-10 animate-slide-up w-full flex flex-col items-center">
                        <span className="bg-[#FFF7ED] text-[#D97706] font-bold px-5 py-2 rounded-full text-sm mb-8 inline-flex items-center gap-2 border border-[#FDE68A] shadow-sm tracking-wide">
                            <IconLeaf /> Personalized dining. Safer choices.
                        </span>

                        <h1 className="text-5xl md:text-7xl font-extrabold text-[#0F172A] tracking-tight mb-6 leading-tight">
                            Know exactly what’s <br/>
                            <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#16A34A] to-emerald-700">on your plate.</span>
                        </h1>

                        <p className="text-xl text-slate-600 mb-10 leading-relaxed max-w-2xl mx-auto">
                            Help guests make informed dining choices with ingredient-level allergen mapping and dynamically filtered, personalized menus.
                        </p>

                        {/* Main CTA */}
                        <div className="flex justify-center mb-8">
                            <button onClick={() => setView('customer')} className="bg-[#16A34A] text-white px-12 py-4 rounded-xl font-bold text-lg hover:bg-[#15803d] shadow-lg shadow-[#16A34A]/30 transition-all duration-300 hover:-translate-y-1 active:scale-95">
                                Try Customer Menu
                            </button>
                        </div>

                        {/* Login Toggle or Login Form */}
                        {!showLogin ? (
                            <div className="animate-fade-in flex flex-col items-center">
                                {/* Trust Line */}
                                <div className="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-slate-500 text-sm font-medium tracking-wide mb-6">
                                    <span className="flex items-center gap-1.5"><IconCheck /> Built for safer dining</span>
                                    <span className="hidden sm:inline text-slate-300">&bull;</span>
                                    <span>Ingredient-level clarity</span>
                                    <span className="hidden sm:inline text-slate-300">&bull;</span>
                                    <span>Personalized menus</span>
                                </div>
                                <button onClick={() => setShowLogin(true)} className="text-sm text-slate-400 hover:text-slate-600 font-medium transition underline underline-offset-4">
                                    Restaurant Admin Login
                                </button>
                            </div>
                        ) : (
                            <form onSubmit={handleLogin} className="mt-4 bg-white/80 backdrop-blur-xl p-8 rounded-3xl border border-slate-200/80 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.1)] w-full max-w-sm mx-auto animate-slide-up text-left relative overflow-hidden">
                                <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[#16A34A] to-emerald-500"></div>
                                <h3 className="text-xl font-extrabold text-slate-800 mb-6 flex items-center justify-center gap-2">
                                    <svg className="w-5 h-5 text-[#16A34A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                    Admin Login
                                </h3>
                                {error && <p className="text-danger-700 text-sm mb-4 font-bold bg-danger-50 p-3 rounded-lg flex items-center gap-2"><IconX/> {error}</p>}

                                <div className="space-y-4 mb-6">
                                    <div>
                                        <label className="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Username</label>
                                        <input type="text" placeholder="admin" value={username} onChange={e=>setUsername(e.target.value)} className="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-[#16A34A] focus:border-[#16A34A] outline-none transition-all shadow-sm bg-white" />
                                    </div>
                                    <div>
                                        <label className="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Password</label>
                                        <input type="password" placeholder="••••••••" value={password} onChange={e=>setPassword(e.target.value)} className="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-[#16A34A] focus:border-[#16A34A] outline-none transition-all shadow-sm bg-white" />
                                    </div>
                                </div>

                                <div className="flex gap-3">
                                    <button type="button" onClick={() => setShowLogin(false)} className="flex-1 px-4 py-3 rounded-xl text-slate-600 font-bold hover:bg-slate-100 transition-colors">Cancel</button>
                                    <button type="submit" className="flex-1 bg-[#0F172A] text-white px-4 py-3 rounded-xl font-bold hover:bg-slate-800 shadow-lg shadow-slate-900/20 transition-all active:scale-95">Sign In</button>
                                </div>
                            </form>
                        )}
                    </div>
                </div>
            );
        }

        /* RESTAURANT DASHBOARD - UNTOUCHED */
        function RestaurantDashboard({ menuItems, fetchMenu }) {
            const [tab, setTab] = useState('overview');
            const [editingItem, setEditingItem] = useState(null);

            const handleTabChange = (newTab) => {
                if (newTab !== 'add') setEditingItem(null);
                setTab(newTab);
            };

            const handleEdit = (item) => {
                setEditingItem(item);
                setTab('add');
            };

            return (
                <div className="flex-1 flex bg-slate-50">
                    <div className="w-64 bg-white border-r border-slate-200 p-4 flex flex-col gap-2">
                        <div className="mb-6 px-2">
                            <h2 className="text-xs font-bold text-slate-400 uppercase tracking-wider">The Spice Table</h2>
                            <p className="text-sm font-semibold text-slate-800">Manager Dashboard</p>
                        </div>
                        <button onClick={() => handleTabChange('overview')} className={`text-left px-3 py-2.5 rounded-lg text-sm font-medium transition ${tab === 'overview' ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-100'}`}>Overview & Menu</button>
                        <button onClick={() => handleTabChange('add')} className={`text-left px-3 py-2.5 rounded-lg text-sm font-medium transition ${tab === 'add' ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-100'}`}>
                            {editingItem ? 'Edit Menu Item' : '+ Add Menu Item'}
                        </button>
                        <button onClick={() => handleTabChange('matrix')} className={`text-left px-3 py-2.5 rounded-lg text-sm font-medium transition ${tab === 'matrix' ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-100'}`}>Allergen Matrix</button>
                    </div>
                    <div className="flex-1 p-8 overflow-y-auto">
                        {tab === 'overview' && <DashboardOverview menuItems={menuItems} fetchMenu={fetchMenu} onEdit={handleEdit} />}
                        {tab === 'add' && <AddMenuItemForm fetchMenu={fetchMenu} setTab={handleTabChange} editingItem={editingItem} />}
                        {tab === 'matrix' && <AllergenMatrix menuItems={menuItems} />}
                    </div>
                </div>
            );
        }

        function DashboardOverview({ menuItems, fetchMenu, onEdit }) {
            const deleteItem = (id) => {
                if (confirm('Are you sure you want to delete this menu item?')) {
                    fetch('/api/menu/' + id, { method: 'DELETE' }).then(() => fetchMenu());
                }
            };
            return (
                <div className="max-w-5xl">
                    <h2 className="text-2xl font-bold text-slate-900 mb-6">Dashboard Overview</h2>
                    <div className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div className="px-6 py-4 border-b border-slate-100 flex justify-between items-center"><h3 className="font-bold text-slate-800">Menu Management</h3></div>
                        <table className="w-full text-left text-sm text-slate-600">
                            <thead className="bg-slate-50 text-slate-500 uppercase text-xs font-semibold">
                                <tr><th className="px-6 py-3">Dish Name</th><th className="px-6 py-3">Category</th><th className="px-6 py-3">Price</th><th className="px-6 py-3">Allergens</th><th className="px-6 py-3">Status</th><th className="px-6 py-3 text-right">Action</th></tr>
                            </thead>
                            <tbody className="divide-y divide-slate-100">
                                {menuItems.map(item => (
                                    <tr key={item.id} className="hover:bg-slate-50 transition">
                                        <td className="px-6 py-4 font-medium text-slate-900">{item.name}</td>
                                        <td className="px-6 py-4">{item.category}</td>
                                        <td className="px-6 py-4">₹{item.price.toFixed(2)}</td>
                                        <td className="px-6 py-4">{item.allergens.length > 0 ? <div className="flex gap-1 flex-wrap">{item.allergens.map(a => <span key={a} className="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-xs">{a}</span>)}</div> : <span className="text-slate-400 italic">None</span>}</td>
                                        <td className="px-6 py-4">{item.status === 'Incomplete' ? <span className="inline-flex items-center gap-1 text-danger-600 bg-danger-50 px-2 py-1 rounded text-xs font-semibold"><IconAlert/> Incomplete</span> : <span className="text-brand-600 bg-brand-50 px-2 py-1 rounded text-xs font-semibold">Complete</span>}</td>
                                        <td className="px-6 py-4 text-right space-x-3">
                                            <button onClick={() => onEdit(item)} className="text-brand-600 hover:text-brand-800 font-bold transition">Edit</button>
                                            <button onClick={() => deleteItem(item.id)} className="text-danger-500 hover:text-danger-700 font-bold transition">Delete</button>
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            );
        }

        function AddMenuItemForm({ fetchMenu, setTab, editingItem }) {
            const [name, setName] = useState(''); const [category, setCategory] = useState('Starters'); const [price, setPrice] = useState(''); const [imageUrl, setImageUrl] = useState(''); const [ingredientsText, setIngredientsText] = useState(''); const [allergens, setAllergens] = useState([]); const [status, setStatus] = useState('Complete');
            useEffect(() => {
                if (editingItem) {
                    setName(editingItem.name || ''); setCategory(editingItem.category || 'Starters'); setPrice(editingItem.price ? editingItem.price.toString() : ''); setImageUrl(editingItem.imageUrl || ''); setIngredientsText(editingItem.ingredients ? editingItem.ingredients.join(', ') : ''); setAllergens(editingItem.allergens || []); setStatus(editingItem.status || 'Complete');
                }
            }, [editingItem]);
            const handleIngredientsChange = (e) => {
                const text = e.target.value; setIngredientsText(text); const currentIngredients = text.split(',').map(i => i.trim().toLowerCase()).filter(i => i); let suggested = new Set();
                currentIngredients.forEach(ing => { Object.keys(INGREDIENT_TO_ALLERGEN_MAP).forEach(key => { if (ing.includes(key)) { suggested.add(INGREDIENT_TO_ALLERGEN_MAP[key]); } }); }); setAllergens(Array.from(suggested));
            };
