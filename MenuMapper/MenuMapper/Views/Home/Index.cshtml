                        ) : isUnsafe ? (
                            <div className="bg-danger-50 border border-danger-200 rounded-xl p-5 md:p-6 mb-8 shadow-sm">
                                <h3 className="font-bold text-danger-800 flex items-center gap-2 mb-1"><IconX/> Not Suitable</h3>
                                <p className="text-sm md:text-base text-danger-700 mt-1">Contains selected allergen: <strong>{conflictingAllergens.join(', ')}</strong></p>
                            </div>
                        ) : selectedAllergies.length > 0 ? (
                            <div className="bg-brand-50 border border-brand-200 rounded-xl p-5 md:p-6 mb-8 shadow-sm">
                                <h3 className="font-bold text-brand-800 flex items-center gap-2 mb-1"><IconCheck/> Suitable Option</h3>
                                <p className="text-sm md:text-base text-brand-700 mt-1">Based on information provided by the restaurant, this item does not contain your selected allergens.</p>
                            </div>
                        ) : null}

                        <div className="space-y-8 md:space-y-10">
                            <div>
                                <h3 className="text-sm font-bold text-slate-400 uppercase tracking-wider mb-3">Category</h3>
                                <p className="text-slate-800 font-medium md:text-lg">{dish.category}</p>
                            </div>

                            <div>
                                <h3 className="text-sm font-bold text-slate-400 uppercase tracking-wider mb-3">Ingredients</h3>
                                <div className="flex flex-wrap gap-2 md:gap-3">
                                    {dish.ingredients.map(ing => (
                                        <span key={ing} className="bg-slate-50 border border-slate-200 text-slate-700 px-4 py-2 rounded-lg text-sm md:text-base font-medium transition hover:shadow-md hover:-translate-y-0.5">{ing}</span>
                                    ))}
                                </div>
                            </div>

                            <div>
                                <h3 className="text-sm font-bold text-slate-400 uppercase tracking-wider mb-3">Allergens Present</h3>
                                {dish.allergens.length > 0 ? (
                                    <div className="flex flex-wrap gap-2 md:gap-3">
                                        {dish.allergens.map(a => (
                                            <span key={a} className={`px-4 py-2 rounded-lg text-sm md:text-base font-bold shadow-sm transition hover:-translate-y-0.5 ${conflictingAllergens.includes(a) ? 'bg-danger-100 text-danger-700 border border-danger-200' : 'bg-slate-800 text-white border border-slate-900 hover:shadow-md'}`}>{a}</span>
                                        ))}
                                    </div>
                                ) : (
                                    <p className="text-sm md:text-base text-slate-500 italic bg-slate-50 p-4 rounded-xl border border-slate-100">No major allergens reported by the kitchen.</p>
                                )}
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
